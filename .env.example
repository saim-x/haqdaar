# Haqdaar — environment template
#
# Copy to `.env` and adjust. Every value here is a development default; nothing
# in this file is a real secret and no value points at a real person.
#
#   cp .env.example .env
#
# Agent worktrees MUST override HOST_DB_PORT / HOST_API_PORT so they do not
# collide with the integration stack on main (5432 / 8000).

# --- host ports (docker compose) --------------------------------------------
# Integration stack on main: 5432 / 8000. Agent worktrees: 5433 / 8010.
HOST_DB_PORT=5433
HOST_API_PORT=8010
COMPOSE_PROJECT_SUFFIX=be

# --- database ---------------------------------------------------------------
POSTGRES_USER=haqdaar
POSTGRES_PASSWORD=haqdaar
POSTGRES_DB=haqdaar
# Used by the API/worker processes and by `pytest`. Inside compose the host is
# `db`; from the host machine it is 127.0.0.1 with HOST_DB_PORT.
DATABASE_URL=postgresql+psycopg://haqdaar:haqdaar@127.0.0.1:5433/haqdaar

# --- security ---------------------------------------------------------------
# HS256 signing key. Production/demo: 64-char random hex
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me
# Signs the QR codes on mock document specimens. Production/demo: 64-char hex.
QR_HMAC_SECRET=dev-qr-secret-change-me

# --- simulated DPI boundary -------------------------------------------------
# The app calls every government service over HTTP at this base URL. The value
# is the HOST ROOT: the client appends absolute paths such as /mock/v1/identity/lookup.
# Inside compose, point this at the api service: http://api:8000/mock
MOCK_BASE_URL=http://127.0.0.1:8000/mock

# --- AI provider ------------------------------------------------------------
# `fake` = deterministic fixtures (no network, used by tests and offline demos).
# `live` = OpenAI, with automatic fallback to `fake` on failure.
AI_PROVIDER=fake
OPENAI_API_KEY=
# Build-time only: generates offline Urdu MP3 prompts with Deepgram Flux TTS.
DEEPGRAM_API_KEY=
# Optional Sindhi TTS. Enable Cloud Text-to-Speech on this billing project.
GOOGLE_CLOUD_PROJECT=
# Short-lived OAuth access token with the cloud-platform scope.
GOOGLE_TTS_ACCESS_TOKEN=
# Gemini Developer API key for live Sindhi TTS. Takes priority over Cloud credentials above.
GEMINI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_STT_MODEL=whisper-1

# --- runtime ----------------------------------------------------------------
# DEMO_MODE=true enables /auth/demo-login (9 personas) and /admin/demo/reset.
# Set to false to prove those routes 404 in production.
DEMO_MODE=true
APP_ENV=dev
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
UPLOAD_DIR=./data/uploads
STATIC_DIR=./static
# Run the job worker inside the API process (single-container deploys).
RUN_EMBEDDED_WORKER=false

# --- worker tuning ----------------------------------------------------------
WORKER_POLL_INTERVAL_MS=500
WORKER_MAX_CONCURRENCY=4
WORKER_MAX_ATTEMPTS=5
WORKER_HEARTBEAT_SECONDS=10
WORKER_HEARTBEAT_STALE_SECONDS=30
WORKER_BACKOFF_SECONDS=15,30,60,120

# --- auth tuning ------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS_CITIZEN=30
REFRESH_TOKEN_TTL_HOURS_STAFF=12
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_PHONE_LIMIT=3
OTP_PHONE_WINDOW_SECONDS=600
OTP_IP_LIMIT=10

# --- uploads ----------------------------------------------------------------
MAX_IMAGE_UPLOAD_BYTES=2097152
MAX_AUDIO_UPLOAD_BYTES=5242880
DOC_VERIFY_SYNC_TIMEOUT_SECONDS=4.0

# --- audit ------------------------------------------------------------------
# Advisory lock key that serialises audit hash-chain writers.
AUDIT_CHAIN_LOCK_KEY=99887766

# --- interactive video guide (ADR-025) --------------------------------------
# "Saima - Haqdaar Guide" renders a face and lip-syncs audio we already made.
# It never receives a question, a case, or a CNIC, and it never decides anything.
#
# Leave ANAM_ENABLED=false for every local run, test and CI job: AI_PROVIDER=fake
# serves the full local simulator (animated guide + real Urdu audio) at zero
# vendor cost. Only a deliberate live demo turns this on.
ANAM_ENABLED=false
# Paste the key here (or in the ignored root .env). Never commit it, never expose
# it through a VITE_* variable, never return it from an endpoint.
ANAM_API_KEY=
# Optional. Blank in live mode means the backend resolves a stock avatar once via
# GET /v1/avatars and caches it. `python backend/scripts/verify_anam.py` prints
# the available ids without spending a single streaming minute.
ANAM_AVATAR_ID=
# Optional. Blank means the backend resolves a voice once via GET /v1/voices and
# caches it. Anam's catalogue has no `ur`-tagged voice, so the resolver prefers
# `ur`, then `hi` (the same spoken language as Urdu), then a warm female voice.
ANAM_VOICE_ID=
# Optional. Blank means the backend resolves Anam's persona-default model once
# via GET /v1/llms. Only conversational mode uses it.
ANAM_LLM_ID=
# conversational = true two-way Urdu voice conversation (default). The vendor
#                  listens to the citizen and answers in its own voice, grounded
#                  by a system prompt built from the live active rule version.
# passthrough    = stream our own Deepgram Flux Urdu audio (zero hallucination,
#                  needs DEEPGRAM_API_KEY + OPENAI_API_KEY)
# talk           = single-turn vendor speech (fallback only)
ANAM_MODE=conversational
ANAM_BASE_URL=https://api.anam.ai
# 165 s sits below the free tier's 180 s session cap; the client warns at 145 s.
ANAM_MAX_SESSION_SECONDS=165
ANAM_IDLE_TIMEOUT_SECONDS=90
# Lets the guide go live while AI_PROVIDER=fake, so a developer with a real key
# can see the real avatar without turning the whole AI layer live. Ignored inside
# pytest and when APP_ENV=test, so a test run can never spend a streaming minute.
# Set this to false before running the Playwright suite against a live-key .env.
ANAM_ALLOW_LIVE_IN_FAKE_AI=true

# --- frontend build (Dockerfile stage 1) ------------------------------------
BUILD_FRONTEND=true
